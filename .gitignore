# Dependencies
node_modules/

# Build output
dist/

# Hasil pembuatan akun LO berisi kredensial, hanya disimpan lokal
/data/backups/
/output/pdf/Akun-LO-*.pdf
/output/xlsx/Akun-LO-*.xlsx
/output/xlsx/Akun-LO-*.xlsx.*
/tmp/sheets/build_lo_accounts.mjs
/tmp/sheets/akun-lo-preview.png

# Environment / secrets (file contoh tetap di-commit)
.env
.env.*
!.env.example

# Vercel CLI
.vercel/

# Foto absensi lokal (development tanpa R2)
uploads/

# Logs
*.log
npm-debug.log*

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Misc
coverage/
*.local
*.local.json
*.local.mjs

