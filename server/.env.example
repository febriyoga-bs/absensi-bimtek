# ===== Database: Supabase =====
# Supabase Dashboard → Connect → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
PGSSL=true
# Koneksi per instance Vercel (biarkan kecil; pooler yang membagi koneksi)
PG_POOL_MAX=3

# ===== Storage: Cloudflare R2 =====
# R2 → Manage R2 API Tokens → buat token "Object Read & Write" khusus bucket ini
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=absensi-bimtek
# Kosongkan R2_BUCKET untuk menyimpan foto di disk lokal (hanya untuk development)
UPLOAD_DIR=./uploads

# ===== Keamanan =====
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang
ADMIN_PASSWORD=ganti-password-admin
# Masa berlaku token absensi (detik)
CHALLENGE_TTL=300
# Batas longgar per IP per menit untuk cek kode (WiFi venue = 1 IP untuk ratusan orang)
IP_RATE_LIMIT=2000

# Lokal saja (Vercel mengabaikan)
PORT=3000
